@model HomeIndexViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Favourite Numbers";

    var staticBaseUrl = Configuration["StaticFiles:BaseUrl"]?.TrimEnd('/');

    string Asset(string path)
    {
        return string.IsNullOrWhiteSpace(staticBaseUrl)
            ? Url.Content($"~/{path}")
            : $"{staticBaseUrl}/{path}";
    }
}

<img src="@Asset("images/CloudHWImage.png")"
     class="img-fluid rounded shadow-sm mb-4"
     alt="Cloud homework image"/>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h3 mb-3">Add Person</h1>

                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="alert alert-success" role="alert">
                        @statusMessage
                    </div>
                }

                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control"/>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FavouriteNumber" class="form-label"></label>
                        <input asp-for="FavouriteNumber" class="form-control" type="number"/>
                        <span asp-validation-for="FavouriteNumber" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">Save to Database</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h3 mb-3">Saved Persons</h2>

                <div class="table-responsive">
                    <table class="table table-striped align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Name</th>
                            <th>Favourite Number</th>
                            <th class="text-end">Delete</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.Persons.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted">No data saved yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var person in Model.Persons)
                            {
                                <tr>
                                    <td>@person.Name</td>
                                    <td>@person.FavouriteNumber</td>
                                    <td class="text-end">
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@person.Id"/>
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    aria-label="Delete @person.Name">
                                                X
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>
}
