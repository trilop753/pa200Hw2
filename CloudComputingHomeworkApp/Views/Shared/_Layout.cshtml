@inject IConfiguration Configuration

@{
    var staticBaseUrl = Configuration["StaticFiles:BaseUrl"]?.TrimEnd('/');

    string Asset(string path)
    {
        return string.IsNullOrWhiteSpace(staticBaseUrl)
            ? Url.Content($"~/{path}")
            : $"{staticBaseUrl}/{path}";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Favourite Numbers</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="@Asset("lib/bootstrap/dist/css/bootstrap.min.css")"/>
    <link rel="stylesheet" href="@Asset("css/site.css")"/>
    <link rel="icon" type="image/x-icon" href="@Asset("favicon.ico")"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Favourite Numbers</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Persons</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - Favourite Numbers
    </div>
</footer>
<script src="@Asset("lib/jquery/dist/jquery.min.js")"></script>
<script src="@Asset("lib/bootstrap/dist/js/bootstrap.bundle.min.js")"></script>
<script src="@Asset("js/site.js")"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
